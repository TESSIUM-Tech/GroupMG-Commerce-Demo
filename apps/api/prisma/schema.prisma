generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  pending_payment
  confirmed
  canceled
  expired
  review_required
}

enum PaymentStatus {
  pending
  approved
  canceled
  rejected
  review_required
}

enum ReservationStatus {
  active
  consumed
  released
}

enum OutboxStatus {
  pending
  published
  failed
}

enum IdentificationType {
  cedula
  ruc
  passport
}

model Category {
  id       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug     String    @unique
  name     String
  products Product[]
}

model Product {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sku               String             @unique
  supplierReference String             @unique
  name              String
  categoryId        String             @db.Uuid
  category          Category           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  priceMinor        Int
  currency          String             @db.Char(3)
  taxRateBps        Int
  imageUrl          String
  imageLicense      String
  published         Boolean            @default(false)
  createdAt         DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime           @default(now()) @updatedAt @db.Timestamptz(3)
  inventory         Inventory?
  items             OrderItem[]
  reservations      StockReservation[]

  @@index([categoryId, published])
}

model Inventory {
  productId     String    @id @db.Uuid
  product       Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse     String    @default("demo-main")
  onHand        Int
  reserved      Int       @default(0)
  sourceVersion Int       @default(0)
  syncedAt      DateTime? @db.Timestamptz(3)
  updatedAt     DateTime  @default(now()) @updatedAt @db.Timestamptz(3)
}

model GuestCustomer {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firstName String
  lastName  String
  email     String
  phone     String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  orders    Order[]
}

model Order {
  id                        String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId                String             @db.Uuid
  customer                  GuestCustomer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  status                    OrderStatus        @default(pending_payment)
  currency                  String             @db.Char(3)
  subtotalMinor             Int
  taxMinor                  Int
  shippingMinor             Int                @default(0)
  shippingTaxMinor          Int                @default(0)
  totalMinor                Int
  fulfillment               String
  shippingZone              String?
  shippingRateVersion       Int?
  shippingTaxRateBps        Int                @default(0)
  shippingAddress           Json?
  customerSnapshot          Json
  billingIdentificationType IdentificationType
  billingIdentification     String
  billingName               String
  billingAddress            Json
  billingEmail              String
  idempotencyKey            String             @unique
  requestHash               String             @db.Char(64)
  accessTokenHash           String             @unique @db.Char(64)
  accessTokenExpiresAt      DateTime           @db.Timestamptz(3)
  reservationExpiresAt      DateTime           @db.Timestamptz(3)
  createdAt                 DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt                 DateTime           @default(now()) @updatedAt @db.Timestamptz(3)
  items                     OrderItem[]
  payments                  Payment[]
  reservations              StockReservation[]
  outbox                    OutboxEvent[]

  @@unique([id, currency])
  @@index([status, reservationExpiresAt])
  @@index([customerId])
}

model OrderItem {
  id                String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId           String  @db.Uuid
  currency          String  @db.Char(3)
  order             Order   @relation(fields: [orderId, currency], references: [id, currency], onDelete: Restrict)
  productId         String  @db.Uuid
  product           Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  sku               String
  supplierReference String
  productName       String
  quantity          Int
  unitPriceMinor    Int
  taxRateBps        Int
  taxMinor          Int
  totalMinor        Int

  @@unique([orderId, productId])
}

model StockReservation {
  id        String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId   String            @db.Uuid
  order     Order             @relation(fields: [orderId], references: [id], onDelete: Restrict)
  productId String            @db.Uuid
  product   Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity  Int
  status    ReservationStatus @default(active)
  expiresAt DateTime          @db.Timestamptz(3)
  createdAt DateTime          @default(now()) @db.Timestamptz(3)

  @@unique([orderId, productId])
  @@index([status, expiresAt])
}

model Payment {
  id                    String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId               String           @db.Uuid
  currency              String           @db.Char(3)
  order                 Order            @relation(fields: [orderId, currency], references: [id, currency], onDelete: Restrict)
  provider              String           @default("payphone")
  clientTransactionId   String           @unique
  providerTransactionId String?
  status                PaymentStatus    @default(pending)
  amountMinor           Int
  verifiedAt            DateTime?        @db.Timestamptz(3)
  createdAt             DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime         @default(now()) @updatedAt @db.Timestamptz(3)
  receipts              WebhookReceipt[]

  @@unique([provider, providerTransactionId])
  @@index([orderId])
  @@index([status, createdAt])
}

model WebhookReceipt {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider    String
  eventKey    String
  paymentId   String    @db.Uuid
  payment     Payment   @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  payloadHash String    @db.Char(64)
  receivedAt  DateTime  @default(now()) @db.Timestamptz(3)
  verifiedAt  DateTime? @db.Timestamptz(3)
  processedAt DateTime? @db.Timestamptz(3)

  @@unique([provider, eventKey])
  @@index([paymentId])
}

model OutboxEvent {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId     String       @db.Uuid
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  type        String       @default("order.confirmed.v1")
  payload     Json
  status      OutboxStatus @default(pending)
  attempts    Int          @default(0)
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)
  publishedAt DateTime?    @db.Timestamptz(3)

  @@unique([orderId, type])
  @@index([status, createdAt])
}

model ShippingRate {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  zone        String
  version     Int
  amountMinor Int
  currency    String    @db.Char(3)
  taxRateBps  Int
  validFrom   DateTime  @db.Timestamptz(3)
  validUntil  DateTime? @db.Timestamptz(3)

  @@unique([zone, version])
  @@index([zone, validFrom])
}
