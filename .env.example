# Solo desarrollo local. Reemplazar antes de usar entornos compartidos.
POSTGRES_USER=commerce
POSTGRES_PASSWORD=local-change-me
POSTGRES_DB=commerce
RABBITMQ_DEFAULT_USER=commerce
RABBITMQ_DEFAULT_PASS=local-change-me

# URL local; codificar caracteres especiales de usuario/clave.
DATABASE_URL=postgresql://commerce:local-change-me@127.0.0.1:5432/commerce?schema=public
# Habilitar únicamente para una base demo.
ALLOW_DEMO_SEED=true

DATABASE_URL_DOCKER=postgresql://commerce:local-change-me@postgres:5432/commerce?schema=public

# Pagos (DEMO-09). disabled: la API arranca sin PayPhone. simulated: doble
# determinista solo para demo/tests. payphone: requiere las variables siguientes.
PAYMENTS_MODE=disabled
# approved, canceled o rejected; solo aplica a PAYMENTS_MODE=simulated.
PAYMENTS_SIMULATED_OUTCOME=approved
# Clave HMAC de al menos 32 caracteres para firmar la URL de aviso. Generar una
# propia, por ejemplo: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
PAYMENTS_CALLBACK_SECRET=
# Aplicación tipo API en ambiente PRUEBAS de PayPhone Developers. Nunca versionar.
PAYPHONE_TOKEN=
# Opcional: algunas aplicaciones solo muestran el token en Credentials.
PAYPHONE_STORE_ID=
# URL pública (https) del gateway que PayPhone podrá llamar; sin barra final.
PAYPHONE_RESPONSE_URL=

# Mensajería (DEMO-12). Sin RABBITMQ_URL el outbox espera en PostgreSQL.
# Mismas credenciales que RABBITMQ_DEFAULT_*; codificar caracteres especiales.
RABBITMQ_URL=amqp://commerce:local-change-me@127.0.0.1:5672
RABBITMQ_URL_DOCKER=amqp://commerce:local-change-me@rabbitmq:5672
